{
  "name": "gebeta",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/domain.test.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "cap:sync": "pnpm run build && pnpm exec cap sync android",
